# Gemini API key (server-side only — never exposed to the frontend)
GEMINI_API_KEY=

# SQLite by default; can be swapped for a PostgreSQL URL later without code changes
DATABASE_URL=sqlite:///./socialens.db

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000

# Optional: path to the tesseract executable if not on PATH (e.g. on Windows)
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
